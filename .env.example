# Daric OS — environment variables
# Copy to `.env.local`. All optional: the OS runs on seed data without any.

# ── Supabase (data + auth for a real deployment) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only, for privileged reads/writes in route handlers / Edge Functions:
# SUPABASE_SERVICE_ROLE_KEY=service-role-key

# ── Transactional email (server-side only — src/lib/email.ts) ─────────
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Daric <daricone.web@gmail.com>
# CONTACT_EMAIL=daricone.web@gmail.com   # defaults the from-address

# ── Payments (server-side secrets — never exposed to the client) ──────
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
# PAYPAL_SECRET=xxxxxxxx
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxxxxxxx
# WISE_API_TOKEN=xxxxxxxx

# ── Deployment (GitHub Pages project site) ────────────────────────────
# NEXT_PUBLIC_BASE_PATH=/daric-os
